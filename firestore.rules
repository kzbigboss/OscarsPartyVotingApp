rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /parties/{partyCode} {
      allow read: if true;
      allow create: if true;
      allow update: if true;

      match /categories/{categoryId} {
        allow read: if true;
        allow write: if true;
      }

      match /guests/{guestId} {
        allow read: if true;
        allow create: if true;
        allow update: if true;
      }

      match /votes/{voteId} {
        allow read: if true;
        allow create, update: if true;
      }
    }
  }
}
