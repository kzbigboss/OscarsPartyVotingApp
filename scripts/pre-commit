#!/usr/bin/env bash
#
# Pre-commit hook: scans staged files for sensitive data before allowing commits.
# Install: npm run prepare (works in both regular repos and worktrees)
#

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

BLOCKED=0
WARNINGS=0

# Get list of staged files (excluding deleted files)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=d 2>/dev/null || true)

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

echo "🔍 Scanning staged files for sensitive data..."

# ─────────────────────────────────────────────
# 1. Block sensitive file types from being committed
# ─────────────────────────────────────────────
SENSITIVE_FILE_PATTERNS=(
  '\.env$'
  '\.env\.local$'
  '\.env\.production$'
  '\.env\.development$'
  '\.pem$'
  '\.key$'
  '\.p12$'
  '\.pfx$'
  '\.jks$'
  '\.keystore$'
  'credentials\.json$'
  'service[-_]?account.*\.json$'
  'firebase[-_]?adminsdk.*\.json$'
  '\.secret$'
  'id_rsa$'
  'id_ed25519$'
  'id_ecdsa$'
)

for file in $STAGED_FILES; do
  for pattern in "${SENSITIVE_FILE_PATTERNS[@]}"; do
    if echo "$file" | grep -qiE "$pattern"; then
      echo -e "${RED}BLOCKED${NC} Sensitive file staged: ${file}"
      BLOCKED=1
    fi
  done
done

# ─────────────────────────────────────────────
# 2. Scan file contents for secret patterns
#    Uses grep -Ei (POSIX extended regex) for macOS compatibility
# ─────────────────────────────────────────────
SECRET_PATTERNS=(
  # AWS
  'AKIA[0-9A-Z]{16}'
  'aws_secret_access_key[[:space:]]*='
  'aws_access_key_id[[:space:]]*='

  # Generic secrets assigned to variables
  '(SECRET|PRIVATE|PASSWORD|PASSWD|TOKEN|AUTH)[_A-Z]*(KEY|TOKEN|SECRET)?['\''"]?[[:space:]]*[:=][[:space:]]*['\''"][^[:space:]'\''\"]{8,}'

  # Private keys
  '-----BEGIN (RSA |EC |DSA |OPENSSH )?PRIVATE KEY-----'
  '-----BEGIN PGP PRIVATE KEY BLOCK-----'

  # Firebase service account (private key, not public config)
  '"private_key"[[:space:]]*:[[:space:]]*"-----BEGIN'
  '"private_key_id"[[:space:]]*:'
  '"client_email"[[:space:]]*:.*iam\.gserviceaccount\.com'

  # Google OAuth
  'client_secret.*\.apps\.googleusercontent\.com'

  # Generic high-risk patterns
  'password[[:space:]]*[:=][[:space:]]*['\''"][^[:space:]'\''\"]{6,}'
  'db_password[[:space:]]*='
  'database_url[[:space:]]*=.*:.*@'

  # Slack / Discord tokens
  'xox[bpors]-[0-9a-zA-Z]{10,}'
  'https://hooks\.slack\.com/services/'
  'https://discord\.com/api/webhooks/'

  # GitHub tokens
  'ghp_[0-9a-zA-Z]{36}'
  'gho_[0-9a-zA-Z]{36}'
  'ghs_[0-9a-zA-Z]{36}'
  'ghr_[0-9a-zA-Z]{36}'
  'github_pat_[0-9a-zA-Z_]{22,}'

  # npm tokens
  'npm_[0-9a-zA-Z]{36}'

  # Stripe
  'sk_live_[0-9a-zA-Z]{24,}'
  'rk_live_[0-9a-zA-Z]{24,}'

  # Twilio
  'SK[0-9a-f]{32}'

  # SendGrid
  'SG\.[0-9A-Za-z_-]{22}\.[0-9A-Za-z_-]{43}'

  # JWT (hardcoded tokens)
  'eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}'
)

for file in $STAGED_FILES; do
  # Skip binary files and common non-sensitive files
  if echo "$file" | grep -qiE '\.(png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot|mp4|webm|pdf|lock)$'; then
    continue
  fi

  # Skip the pre-commit hook itself (contains example patterns, not real secrets)
  if [ "$file" = "scripts/pre-commit" ]; then
    continue
  fi

  # Get staged content (not working tree content)
  CONTENT=$(git show ":$file" 2>/dev/null || true)
  if [ -z "$CONTENT" ]; then
    continue
  fi

  for pattern in "${SECRET_PATTERNS[@]}"; do
    MATCHES=$(echo "$CONTENT" | grep -niE "$pattern" 2>/dev/null || true)
    if [ -n "$MATCHES" ]; then
      echo -e "${RED}BLOCKED${NC} Potential secret in ${file}:"
      echo "$MATCHES" | head -3 | while IFS= read -r line; do
        echo -e "  ${YELLOW}→${NC} $line"
      done
      MATCH_COUNT=$(echo "$MATCHES" | wc -l | tr -d ' ')
      if [ "$MATCH_COUNT" -gt 3 ]; then
        echo -e "  ${YELLOW}...and $((MATCH_COUNT - 3)) more matches${NC}"
      fi
      BLOCKED=1
    fi
  done
done

# ─────────────────────────────────────────────
# 3. Check for large files (>1MB) that might be accidental
# ─────────────────────────────────────────────
for file in $STAGED_FILES; do
  FILE_SIZE=$(git cat-file -s ":$file" 2>/dev/null || echo 0)
  if [ "$FILE_SIZE" -gt 1048576 ]; then
    SIZE_MB=$(echo "scale=1; $FILE_SIZE / 1048576" | bc)
    echo -e "${YELLOW}WARNING${NC} Large file (${SIZE_MB}MB): ${file}"
    WARNINGS=1
  fi
done

# ─────────────────────────────────────────────
# Result
# ─────────────────────────────────────────────
echo ""
if [ "$BLOCKED" -eq 1 ]; then
  echo -e "${RED}✗ Commit blocked — sensitive data detected.${NC}"
  echo -e "  If this is a false positive, commit with: ${YELLOW}git commit --no-verify${NC}"
  exit 1
fi

if [ "$WARNINGS" -eq 1 ]; then
  echo -e "${YELLOW}⚠ Warnings found (commit allowed)${NC}"
else
  echo -e "${GREEN}✓ No sensitive data detected${NC}"
fi

exit 0
